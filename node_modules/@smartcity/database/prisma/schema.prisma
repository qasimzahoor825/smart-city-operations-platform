// SmartCity OS — Unified PostgreSQL + PostGIS schema
// Run: npm run db:generate && npm run db:push (in packages/database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  CITIZEN
  OFFICER
  DEPARTMENT_HEAD
  SUPER_ADMIN
}

enum TicketStatus {
  SUBMITTED
  RECEIVED
  ASSIGNED
  UNDER_REVIEW
  FIELD_INSPECTION
  IN_PROGRESS
  RESOLVED
  CITIZEN_FEEDBACK
  CLOSED
  REJECTED
  ESCALATED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyType {
  FIRE
  MEDICAL
  FLOOD
  ACCIDENT
  PUBLIC_ALERT
}

enum EmergencyStatus {
  REPORTED
  ACKNOWLEDGED
  DISPATCHED
  ON_SCENE
  RESOLVED
  CLOSED
}

enum NotificationType {
  IN_APP
  EMAIL
  PUSH
  SMS
  SYSTEM
}

enum AssetStatus {
  ACTIVE
  OPERATIONAL
  MAINTENANCE
  UNDER_MAINTENANCE
  DAMAGED
  INACTIVE
  RETIRED
  OUT_OF_SERVICE
}

enum AssetCategory {
  ROAD
  WATER
  ELECTRICITY
  STREET_LIGHT
  PARK
  BUILDING
  PUBLIC_TRANSPORT
  SANITATION
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ===================== MODELS =====================

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  passwordHash        String
  fullName            String
  phoneNumber         String?
  role                Role                  @default(CITIZEN)
  isActive            Boolean               @default(true)
  isEmailVerified     Boolean               @default(false)
  departmentId        String?
  department          Department?           @relation("DepartmentMembers", fields: [departmentId], references: [id])
  lastLoginAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  complaints          Complaint[]           @relation("SubmittedComplaints")
  assignedComplaints  Complaint[]           @relation("AssignedComplaints")
  payments            Payment[]
  assets              Asset[]
  appointments        Appointment[]
  notifications       Notification[]
  emergencyReports    EmergencyEvent[]
  feedback            FeedbackRating[]
  loginActivities     AuditLog[]            @relation("LoginAudit")
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  comments            ComplaintComment[]
}

model RefreshToken {
  id       String   @id @default(uuid())
  token    String   @unique
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked  Boolean  @default(false)
  userAgent String?
  ip       String?
  rememberMe Boolean @default(false)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  members     User[]     @relation("DepartmentMembers")
  complaints  Complaint[]
  appointments Appointment[]
  createdAt   DateTime   @default(now())
}

model Complaint {
  id            String         @id @default(uuid())
  title         String
  description   String
  category      String
  status        TicketStatus   @default(SUBMITTED)
  priority      TicketPriority @default(MEDIUM)
  latitude      Float?
  longitude     Float?
  address       String?
  imageUrls     String[]
  slaHours      Int
  slaDeadline   DateTime?
  resolvedAt    DateTime?
  citizenId     String
  citizen       User           @relation("SubmittedComplaints", fields: [citizenId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  comments      ComplaintComment[]
  timestamps    ComplaintTimeline[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([citizenId])
  @@index([status])
  @@index([departmentId])
}

model ComplaintComment {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
}

model ComplaintTimeline {
  id          String       @id @default(uuid())
  complaintId String
  complaint   Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      TicketStatus
  note        String?
  actorId     String?
  createdAt   DateTime     @default(now())
}

model Asset {
  id          String        @id @default(uuid())
  name        String
  category    AssetCategory @default(OTHER)
  status      AssetStatus   @default(OPERATIONAL)
  latitude    Float?
  longitude   Float?
  address     String?
  imageUrl    String?
  department  String
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  maintainedBy String?
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id])
  inspections  AssetInspection[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AssetInspection {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectorId String?
  status    String
  findings  String
  inspectedBy String
  createdAt DateTime @default(now())
}

model Appointment {
  id            String            @id @default(uuid())
  title         String
  description   String?
  scheduledAt   DateTime
  status        AppointmentStatus @default(PENDING)
  citizenId     String
  citizen       User              @relation(fields: [citizenId], references: [id])
  departmentId  String?
  department    Department?       @relation(fields: [departmentId], references: [id])
  createdAt     DateTime          @default(now())
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType @default(IN_APP)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  channel     String
  isRead      Boolean          @default(false)
  payload     Json?
  createdAt   DateTime         @default(now())

  @@index([userId])
}

model EmergencyEvent {
  id          String          @id @default(uuid())
  type        EmergencyType
  title       String
  description String
  severity    TicketPriority  @default(HIGH)
  status      EmergencyStatus @default(REPORTED)
  latitude    Float?
  longitude   Float?
  address     String?
  reportedById String?
  reportedBy  User?           @relation(fields: [reportedById], references: [id])
  dispatchStatus String?
  timeline    String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FeedbackRating {
  id          String   @id @default(uuid())
  targetType  String
  targetId    String
  rating      Int
  comment     String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  actorId   String?
  actor     User?    @relation("LoginAudit", fields: [actorId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  billType       String
  amount         Float
  currency       String   @default("USD")
  status         String   @default("PENDING")
  transactionRef String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  description    String?
  paidAt         DateTime @default(now())
}

model IoTSensorReading {
  id          String   @id @default(uuid())
  sensorId    String
  sensorType  String
  metricName  String
  metricValue Float
  unit        String
  latitude    Float
  longitude   Float
  timestamp   DateTime @default(now())

  @@index([sensorId, timestamp])
}