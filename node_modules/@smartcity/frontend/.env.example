# === App ===
NEXT_PUBLIC_APP_NAME="SmartCity Ops"
NEXT_PUBLIC_APP_ENV=development

# === API ===
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100
NEXT_PUBLIC_API_TIMEOUT=15000

# === Auth ===
NEXT_PUBLIC_AUTH_TOKEN_KEY=smartcity_access_token
NEXT_PUBLIC_AUTH_REFRESH_KEY=smartcity_refresh_token

# === Map / GIS ===
# Raster tile URL template. Use {z}/{x}/{y} placeholders; add {key} if your provider needs one.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Basemap / tile provider API key (keep blank for OSM; add for keyed providers).
NEXT_PUBLIC_MAP_TILE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_IMAGE_DOMAIN=res.cloudinary.com

# === Feature toggles ===
NEXT_PUBLIC_ENABLE_MAPBOX=false