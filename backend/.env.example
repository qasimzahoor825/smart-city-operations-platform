# ================================================================
# SmartCity OS — Backend Service Environment Variables (example)
# Copy to .env per-service or set these for the docker-compose stack.
# ================================================================

# --- Database (shared Prisma schema) ---
DATABASE_URL=postgresql://smartcity_admin:smartcity_secure_password@localhost:5432/smartcity_db?schema=public

# --- MongoDB (monolith persistence) ---
MONGODB_URL=mongodb://localhost:27017/enterprise-smart-city-platform

# --- Auth Service (4001) ---
PORT=4001
JWT_SECRET=change_me_strong_secret_at_least_32_chars
REFRESH_SECRET=change_me_another_strong_secret
ACCESS_TOKEN_TTL=15m
MAX_SESSIONS_PER_USER=8

# --- API Gateway (4000) ---
PORT=4000
CORS_ORIGIN=*
AUTH_SERVICE_URL=http://localhost:4001
COMPLAINT_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4003
GIS_SERVICE_URL=http://localhost:4004
IOT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
DEPARTMENT_SERVICE_URL=http://localhost:4007

# --- Complaint Service (4002) ---
PORT=4002

# --- Payment Service (4003) ---
PORT=4003

# --- GIS Service (4004) ---
PORT=4004

# --- IoT Telemetry Service (4005) ---
PORT=4005

# --- Notification Service (4006) ---
PORT=4006
EMAIL_TRANSPORT=mock-console

# --- Department / Operations Service (4007) ---
PORT=4007

# --- Platform ---
NODE_ENV=development

# --- AI (Gemini) ---
# Set GEMINI_API_KEY to enable AI-powered complaint triage (auto-categorization,
# priority estimation, summary). Without it, the /ai/categorize endpoint falls
# back to deterministic keyword classification.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash