# Backend monolith — multi-stage build for the Express + Socket.io API.
# Build:  docker build -f infrastructure/docker/Dockerfile.backend .   (context = repo root)
# Run:    docker run -p 4100:4100 -e PORT=4100 -e JWT_SECRET=... smartcity-backend
ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY backend ./backend
RUN npm ci --ignore-scripts || npm install --ignore-scripts
RUN npm run build --prefix packages/common \
    && npm run build --prefix packages/shared \
    && npm run db:generate --prefix packages/database \
    && npm run build --prefix packages/database \
    && npm run build --prefix backend

FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache openssl tini
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/backend/package.json ./backend/package.json
EXPOSE 4100
CMD ["tini", "--", "node", "backend/dist/server/index.js"]